{
  "name": "tree-sitter-quint",
  "version": "0.1.0",
  "description": "Quint grammar for Tree-sitter",
  "license": "Apache-2.0",
  "main": "bindings/node",
  "types": "bindings/node/index.d.ts",
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "bindings/node/binding.cc",
    "bindings/node/index.js",
    "bindings/node/index.d.ts",
    "queries/highlights.scm",
    "src/parser.c",
    "src/scanner.c",
    "src/node-types.json",
    "src/tree_sitter/alloc.h",
    "src/tree_sitter/array.h",
    "src/tree_sitter/parser.h"
  ],
  "scripts": {
    "generate": "tree-sitter generate",
    "install": "node-gyp-build",
    "test:corpus": "tree-sitter test",
    "test:highlight": "tree-sitter test --file-name basic.qnt",
    "test:fixtures": "node test/scripts/check-fixtures.mjs",
    "test:node": "node --test bindings/node/binding_test.js",
    "test:node-types": "node test/node-types.test.js",
    "test:types": "tsc --noEmit --strict --module node16 --moduleResolution node16 bindings/node/index_test.ts",
    "test": "npm run test:corpus && npm run test:highlight && npm run test:node-types && npm run test:node && npm run test:types && npm run test:fixtures && npm run check:generated",
    "check:generated": "npm run generate && git diff --exit-code -- src/grammar.json src/node-types.json src/parser.c src/scanner.c src/tree_sitter"
  },
  "dependencies": {
    "node-addon-api": "8.3.1",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "tree-sitter": "0.25.0",
    "tree-sitter-cli": "0.26.13",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "tree-sitter": "0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "tree-sitter": [{ "scope": "source.quint", "file-types": ["qnt"] }]
}
